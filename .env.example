# Remplacez MOT_DE_PASSE par celui de votre utilisateur PostgreSQL.
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/place_commune"

# Clé de signature des sessions, 32 caractères minimum. Pour en générer une :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Ville affichée par défaut (slug), tant que l'habitant n'en a pas choisi une.
VILLE_PAR_DEFAUT="dijon"

# Keycloak (docker compose up -d). Valeurs de développement : le secret doit être changé en production.
APP_URL="http://localhost:3000"
KEYCLOAK_ISSUER="http://localhost:8080/realms/place-commune"
KEYCLOAK_CLIENT_ID="place-commune-web"
KEYCLOAK_CLIENT_SECRET="dev-secret-a-changer-en-production"

# Mode démo : comptes fictifs avec connexion directe, sans Keycloak. Jamais en production.
MODE_DEMO="true"
