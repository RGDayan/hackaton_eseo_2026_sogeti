// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  username    String       @unique
  suggestions Suggestion[]
  votes       Vote[]
}

model Vote {
  id           String     @id @default(uuid())
  statut       Boolean
  userId       String
  suggestionId String
  User         User       @relation(fields: [userId], references: [id])
  Suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestionId])
}

model Suggestion {
  id            String         @id @default(uuid())
  titre         String
  description   String
  userId        String
  User          User           @relation(fields: [userId], references: [id])
  votes         Vote[]
  pieceJointes  PieceJointe[]
  tags          Tag[]          @relation("SuggestionTags")
  localisations Localisation[] @relation("SuggestionLocalisations")
  categories    Categorie[]    @relation("SuggestionCategories")
}

model PieceJointe {
  id           String     @id @default(uuid())
  url          String
  suggestionId String
  Suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String       @id @default(uuid())
  name        String
  suggestions Suggestion[] @relation("SuggestionTags")
}

model Localisation {
  id          String       @id @default(uuid())
  nom         String
  latitude    Float
  longitude   Float
  suggestions Suggestion[] @relation("SuggestionLocalisations")
  categories  Categorie[]  @relation("CategorieLocalisations")
}

model Categorie {
  id            String         @id @default(uuid())
  name          String
  suggestions   Suggestion[]   @relation("SuggestionCategories")
  localisations Localisation[] @relation("CategorieLocalisations")
}
