# Configuration de production. Copier en `.env` (dans ce dossier) et remplir chaque valeur.
# Générer les secrets avec : openssl rand -hex 32
# (hexadécimal uniquement : les mots de passe PostgreSQL sont insérés dans une URL de connexion)

# Nom de domaine public, sans https://. Sans domaine, utiliser sslip.io avec l'IP publique
# du serveur, points remplacés par des tirets : 51.75.10.20 → 51-75-10-20.sslip.io
DOMAINE=""

# Ville affichée tant que l'habitant n'en a pas choisi une.
VILLE_PAR_DEFAUT="dijon"

# Signature des cookies de session (32 caractères minimum).
SESSION_SECRET=""

# Base de l'application et base de Keycloak.
POSTGRES_PASSWORD=""
KEYCLOAK_DB_PASSWORD=""

# Console Keycloak (https://<DOMAINE>/kc/admin/, identifiant `admin`).
KEYCLOAK_ADMIN_PASSWORD=""

# Secret du client OIDC place-commune-web, partagé entre Keycloak et l'application.
KEYCLOAK_CLIENT_SECRET=""

# Mot de passe des 4 comptes de démo du realm (habitant.demo, moderateur.dijon,
# moderateur.besancon, admin.demo). Différent de celui du dépôt, qui est public.
MDP_COMPTES_DEMO=""
